{
  "title": "JWT Algorithm Load Test (HS384 vs RS256)",
  "uid": "jwt-algo-comparison",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "",
  "tags": ["k6", "jwt", "load-test"],
  "templating": {
    "list": [
      {
        "name": "algo",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
        "query": { "query": "label_values(k6_http_req_duration_p95, algo)", "refId": "algoVar" },
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "phase",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
        "query": { "query": "label_values(k6_http_req_duration_p95, phase)", "refId": "phaseVar" },
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "실패율 — VU 스테이지별 (몇 명부터 터지는지)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "실패율(%) 시간 추이 — VU 스테이지가 순차 진행되므로 계단식으로 표시됨",
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "k6_http_req_failed_rate{algo=~\"$algo\", phase=~\"$phase\"} * 100",
          "legendFormat": "{{algo}} / {{phase}} / vus={{vus}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "spanNulls": false, "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 5 }
            ]
          },
          "custom.thresholdsStyle": { "mode": "line" }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max"] } }
    },
    {
      "id": 3,
      "type": "table",
      "title": "VU 스테이지별 실패율(%) — 알고리즘/phase별 정리",
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 10 },
      "targets": [
        {
          "expr": "max by (algo, phase, vus) (max_over_time(k6_http_req_failed_rate{algo=~\"$algo\", phase=~\"$phase\"}[$__range])) * 100",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "Value": "실패율(%)" } } },
        { "id": "convertFieldType", "options": { "conversions": [{ "targetField": "vus", "destinationType": "number" }], "fields": {} } }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "실패율(%)" }, "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-background" } }] }
        ]
      },
      "options": { "sortBy": [{ "displayName": "phase", "desc": false }, { "displayName": "algo", "desc": false }, { "displayName": "vus", "desc": false }] }
    },
    {
      "id": 4,
      "type": "row",
      "title": "응답시간 — HS384 vs RS256 비교",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
      "collapsed": false
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "p95 응답시간 (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "k6_http_req_duration_p95{algo=~\"$algo\", phase=~\"$phase\"}",
          "legendFormat": "{{algo}} / {{phase}} / vus={{vus}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max"] } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "p99 응답시간 (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "k6_http_req_duration_p99{algo=~\"$algo\", phase=~\"$phase\"}",
          "legendFormat": "{{algo}} / {{phase}} / vus={{vus}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max"] } }
    },
    {
      "id": 7,
      "type": "table",
      "title": "VU 스테이지별 p95 응답시간(ms) — 알고리즘/phase별 정리",
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 29 },
      "targets": [
        {
          "expr": "max by (algo, phase, vus) (max_over_time(k6_http_req_duration_p95{algo=~\"$algo\", phase=~\"$phase\"}[$__range]))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "Value": "p95(ms)" } } },
        { "id": "convertFieldType", "options": { "conversions": [{ "targetField": "vus", "destinationType": "number" }], "fields": {} } }
      ],
      "options": { "sortBy": [{ "displayName": "phase", "desc": false }, { "displayName": "algo", "desc": false }, { "displayName": "vus", "desc": false }] }
    },
    {
      "id": 8,
      "type": "table",
      "title": "VU 스테이지별 p99 응답시간(ms) — 알고리즘/phase별 정리",
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 29 },
      "targets": [
        {
          "expr": "max by (algo, phase, vus) (max_over_time(k6_http_req_duration_p99{algo=~\"$algo\", phase=~\"$phase\"}[$__range]))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "Value": "p99(ms)" } } },
        { "id": "convertFieldType", "options": { "conversions": [{ "targetField": "vus", "destinationType": "number" }], "fields": {} } }
      ],
      "options": { "sortBy": [{ "displayName": "phase", "desc": false }, { "displayName": "algo", "desc": false }, { "displayName": "vus", "desc": false }] }
    },
    {
      "id": 9,
      "type": "row",
      "title": "처리량",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 38 },
      "collapsed": false
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "처리량 (req/s) — algo/phase별",
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 39 },
      "targets": [
        {
          "expr": "sum by (algo, phase) (rate(k6_http_reqs_total{algo=~\"$algo\", phase=~\"$phase\"}[30s]))",
          "legendFormat": "{{algo}} / {{phase}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max"] } }
    }
  ]
}
