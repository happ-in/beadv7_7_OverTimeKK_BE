# docker-compose.deploy.yml용 환경변수 템플릿
# 실제 값 채워서 .env로 저장 (커밋 금지, .gitignore에 이미 등록됨)

# GHCR 이미지 경로 (예: prgrms-be-adv-devcourse/beadv7_7_overtimekk_be)
GHCR_OWNER=
IMAGE_TAG=latest

# 프론트(Next.js SSR) 이미지 - beadv7_7_OverTimeKK_FE 저장소 자체 GHCR 네임스페이스
# 예: ghcr.io/prgrms-be-adv-devcourse/beadv7_7_overtimekk_fe/frontend:latest
FRONTEND_IMAGE=

# MySQL
MYSQL_ROOT_PASSWORD=

# order-service: 결제키 암호화용 (openssl rand -base64 32로 생성)
ENCRYPTION_SECRET_KEY=

# order-service: 토스페이먼츠
TOSS_SECRET_KEY=
TOSS_CLIENT_KEY=

# user/order/performance-service 공용 JWT 서명 키
JWT_SECRET=
